# Tienda in-game (tools/bnet-shop/shop-server.mjs). Copiar a shop.env (chmod 600) y rellenar.
# Las credenciales de MariaDB se toman de LEGION_DB_USER/LEGION_DB_PASS (~/legioncore/db.env)
# o de SHOP_DB_USER/SHOP_DB_PASS.

SHOP_PORT=8096
SHOP_BIND=0.0.0.0
# URL con la que llega el cliente (target de www.battle.net en auth.browser_url_map)
SHOP_PUBLIC_URL=https://tienda.example.com:8096
SHOP_TLS_CERT=/home/ubuntu/legion_shop/certs/shop.crt
SHOP_TLS_KEY=/home/ubuntu/legion_shop/certs/shop.key
SHOP_NAME=Tienda
SHOP_LOG=/home/ubuntu/legion_shop/shop.log

SHOP_DB_HOST=127.0.0.1
SHOP_DB_PORT=3306
SHOP_DB_AUTH=rc_auth
SHOP_DB_WORLD=rc_world
SHOP_DB_CHARACTERS=rc_characters
SHOP_DB_USER=rustycore
SHOP_DB_PASS=

# SumUp: clave secreta de API (Perfil > Desarrolladores > Claves de API, "sup_sk_...") y código
# de comercio ("M....", en Perfil). Sin webhooks: el estado se consulta con GET /v0.1/checkouts/{id}.
SUMUP_API=https://api.sumup.com
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Cada cuántos ms pregunta la página por el estado del pago tras el widget
SHOP_POLL_MS=3000

# Reclutar a un amigo (raf.mjs): el worldserver (RecruitAFriend.Enabled = 1) guarda las
# invitaciones y esta web manda el email con el enlace <RAF_PUBLIC_URL>/raf/<token> (por defecto
# SHOP_PUBLIC_URL; debe ser alcanzable desde fuera del juego) y registra la cuenta del reclutado.
# Sin RAF_SMTP_HOST no se envía nada: el enlace se escribe en el log (pruebas).
#RAF_PUBLIC_URL=https://mi-servidor.com:8095
#RAF_SMTP_HOST=smtp.example.com
#RAF_SMTP_PORT=587
#RAF_SMTP_SECURE=0
#RAF_SMTP_USER=
#RAF_SMTP_PASS=
#RAF_MAIL_FROM=noreply@mi-servidor.com
#RAF_MAIL_FROM_NAME=Mi servidor
# Idioma del email (es/en), días de validez del enlace y expansión de la cuenta de juego creada
RAF_MAIL_LANG=es
RAF_INVITE_DAYS=30
RAF_EXPANSION=6

# Twitter (X) del cliente: app OAuth 2.0 confidencial de developer.x.com (pago por uso).
# Callback a dar de alta en la app: <TWITTER_PUBLIC_URL>/oauth/x-callback
X_CLIENT_ID=
X_CLIENT_SECRET=
TWITTER_PUBLIC_URL=https://nightspire.gg
# 1 (por defecto): la autorizacion de X se hace en el navegador de Windows del jugador y la ventana del juego espera;
# 0: dentro del navegador del juego (Google y X bloquean el login en navegadores embebidos).
TWITTER_EXTERNAL_BROWSER=1
#X_REDIRECT_URI=https://nightspire.gg/oauth/x-callback
#X_SCOPES=tweet.read tweet.write users.read media.write offline.access
